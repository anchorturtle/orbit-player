{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-player",
  "compatibility_date": "2025-09-27",
  "pages_build_output_dir": "./pages-dist",
  "build": {
    "command": "node scripts/prepare-pages.mjs"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}